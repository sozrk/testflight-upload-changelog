{
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "watch": "tsx --watch src/index.ts",
    "test": "tsx --test src/*.test.ts",
    "bundle": "esbuild src/index.ts --bundle --outfile=dist/bundle.cjs --format=cjs --platform=node --target=node20 --sourcemap --minify --tree-shaking=true",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/http-client": "^2.2.3",
    "jose": "^6.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20",
    "esbuild": "^0.25.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
