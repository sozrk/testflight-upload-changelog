{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "ignore": ["dist/"] },
  "linter": {
    "rules": {
      "style": {
        "all": true,
        "noNamespaceImport": "off",
        "noDefaultExport": "off"
      },
      "complexity": {
        "all": true
      },
      "correctness": {
        "all": true,
        "noNodejsModules": "off"
      },
      "suspicious": {
        "all": true,
        "useErrorMessage": "off"
      },
      "security": {
        "all": true
      }
    }
  },
  "formatter": {
    "lineWidth": 112,
    "indentWidth": 2,
    "indentStyle": "space",
    "lineEnding": "lf",
    "bracketSpacing": true
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "asNeeded",
      "quoteStyle": "double",
      "quoteProperties": "asNeeded"
    }
  }
}
